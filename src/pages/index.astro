---
import Hero from "../components/views/HeroView/Hero.astro";
import Navbar from "../components/shared/navbar/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import BenefitsView from "../components/views/BenefitsView/Benefit.astro";
import StepsView from "../components/views/Steps/StepsView.astro";
import AllYouNeedView from "../components/views/AllYouNeed/AllYouNeedView.astro";
import TablePlans from "../components/views/Plans/TablePlans.astro";
---

<Layout>
  <Navbar />
  <main
    class="flex flex-col gap-8 xl:py-18 xl:px-41 lg:py-10 lg:px-30 px-4 py-2 sm:px-8 sm:py-4 md:px-20 md:py-8"
  >
    <Hero />
    <BenefitsView />
    <StepsView />
    <AllYouNeedView />
    <TablePlans />
  </main>
</Layout>
