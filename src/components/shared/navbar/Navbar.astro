---
import Moon from "@lucide/astro/icons/moon";
import Button from "../Button.astro";
import NavLink from "./NavLink.astro";
import ThemeSelector from "./ThemeSelector.astro";
import Container from "../Container.astro";

const navLinksLabels = [
  {
      label: "Cómo funciona",
      redirect: "#como-funciona"
  },
  {
      label: "Precios",
      redirect: "#precios"
  },
  {
      label: "Quienes somos",
      redirect: "#quienes-somos"
  },
  {
      label: "Preguntas frecuentes",
      redirect: "#preguntas-frecuentes"
  },

];
---

<header class="fixed z-20 w-full top-0 left-0">
  <nav
    class="bg-surface-elevated/70 backdrop-blur-md border-b border-border-default"
  >
    <Container class="flex py-4 justify-between items-center">
      <a href="#" class="text-2xl text-primary font-black tracking-tight">Marki</a>

      <div class="flex gap-4">
        {navLinksLabels.map((link) => <NavLink label={link.label} redirect={link.redirect} />)}
      </div>

      <div class="flex gap-4">
        <ThemeSelector />
        <Button variant="primary" type="rounded"> Agendar una demo </Button>
      </div>
    </Container>
  </nav>
</header>
