---
const { label, onClick, redirect } = Astro.props;
---

<a
  class="radius-sm flex px-3 py-2 hover:underline cursor-pointer hover:underline-offset-2 hover:decoration-ui-dark hover:decoration-wavy transition ease-in-out duration-1000 items-center gap-2 font-bold leading-loose text-ui-dark"
  onclick={onClick}
  aria-label={label}
  role="button"
  title={label}
  href={redirect}
>
  {label}
</a>
