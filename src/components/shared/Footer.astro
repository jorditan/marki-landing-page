---
import Container from "./Container.astro";

const currentYear = new Date().getFullYear();

const productLinks = [
  { label: "Cómo funciona", href: "#como-funciona" },
  { label: "Precios", href: "#precios" },
  { label: "Quiénes somos", href: "#quienes-somos" },
  { label: "Preguntas frecuentes", href: "#preguntas-frecuentes" },
];

const supportLinks = [
  { label: "Agendar una demo", href: "#" },
  { label: "Contacto", href: "marketingbts2026@gmail.com" },
];

---

<footer class="w-full border-t border-border-default/80 bg-surface-elevated-alt/50 backdrop-blur-md py-16 lg:py-24 relative overflow-hidden z-0">
  <!-- Subtle glowing background blob -->
  <div class="absolute bottom-0 left-1/4 -translate-x-1/2 w-87.5 h-87.5 bg-primary/5 dark:bg-primary/10 rounded-full blur-[100px] pointer-events-none z-[-1]"></div>

  <Container class="flex flex-col gap-12 lg:gap-16">
    <!-- Top section: Columns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      
      <!-- Brand column (Spans 2 columns on lg) -->
      <div class="flex flex-col gap-4 lg:col-span-2">
        <a href="#" class="flex items-center gap-2.5 text-3xl text-primary font-black tracking-tight w-fit transition-transform hover:scale-105">
          <img src="/marki-icons/marki-icon.svg" alt="Marki logo" class="w-8 h-8" />
          <span>Marki</span>
        </a>
        <p class="text-ui-muted text-base font-semibold leading-relaxed max-w-sm">
          Tu aliado en redes sociales. Dejá de adivinar qué publicar y empezá a crecer con estrategia.
        </p>
        
        <!-- Social links -->
        <div class="flex items-center gap-3 mt-2">
          <!-- Twitter/X -->
          <a href="https://www.facebook.com/profile.php?id=61590328116645&rdid=iirglbyIRMyDEZQx&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F195CzmqeVy%2F#" target="_blank" rel="noopener noreferrer"aria-label="Twitter" class="flex items-center justify-center w-10 h-10 rounded-xl border border-border-default bg-surface-white dark:bg-transparent text-ui-muted hover:text-primary hover:border-primary transition-all duration-300 shadow-xs">
            <svg viewBox="0 0 666.667 666.667" class="h-4 w-4" fill="currentColor" stroke="currentColor"><defs><clipPath id="facebook_icon__a" clipPathUnits="userSpaceOnUse"><path d="M0 700h700V0H0Z"/></clipPath></defs><g clip-path="url(#facebook_icon__a)" transform="matrix(1.33333 0 0 -1.33333 -133.333 800)"><path d="M0 0c0 138.071-111.929 250-250 250S-500 138.071-500 0c0-117.245 80.715-215.622 189.606-242.638v166.242h-51.552V0h51.552v32.919c0 85.092 38.508 124.532 122.048 124.532 15.838 0 43.167-3.105 54.347-6.211V81.986c-5.901.621-16.149.932-28.882.932-40.993 0-56.832-15.528-56.832-55.9V0h81.659l-14.028-76.396h-67.631v-171.773C-95.927-233.218 0-127.818 0 0" style="fill-opacity:1;fill-rule:nonzero;stroke:none" transform="translate(600 350)"/><path d="m0 0 14.029 76.396H-67.63v27.019c0 40.372 15.838 55.899 56.831 55.899 12.733 0 22.981-.31 28.882-.931v69.253c-11.18 3.106-38.509 6.212-54.347 6.212-83.539 0-122.048-39.441-122.048-124.533V76.396h-51.552V0h51.552v-166.242a250.559 250.559 0 0 1 60.394-7.362c10.254 0 20.358.632 30.288 1.831V0Z" style="fill:#fff;fill-opacity:1;fill-rule:nonzero;stroke:none" transform="translate(447.918 273.604)"/></g></svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/markii.app" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex items-center justify-center w-10 h-10 rounded-xl border border-border-default bg-surface-white dark:bg-transparent text-ui-muted hover:text-primary hover:border-primary transition-all duration-300 shadow-xs">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </a>
  
        </div>
      </div>

      <!-- Links Column: Product -->
      <div class="flex flex-col gap-5 w-full">
        <span class="text-ui-dark text-sm font-bold tracking-wider uppercase">Producto</span>
        <ul class="flex flex-col gap-3">
          {productLinks.map((link) => (
            <li>
              <a href={link.href} class="text-ui-muted hover:text-primary font-semibold text-base transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links Column: Support -->
      <div class="flex flex-col gap-5 w-full">
        <span class="text-ui-dark text-sm font-bold tracking-wider uppercase">Soporte</span>
        <ul class="flex flex-col gap-3">
          {supportLinks.map((link) => (
            <li>
              <a href={link.href} class="text-ui-muted hover:text-primary font-semibold text-base transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Divider -->
    <div class="h-px w-full bg-border-default/60"></div>

    <!-- Bottom section: Copyright, status and signature -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 w-full">
      <!-- Copyright -->
      <span class="text-ui-muted text-sm font-bold order-3 sm:order-1">
        © {currentYear} Marki. Todos los derechos reservados.
      </span>

    </div>

  </Container>
</footer>
