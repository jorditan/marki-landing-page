---
interface Props {
  variant?: "default" | "primary";
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const baseStyles =
  "badge flex gap-2 border rounded-[90px] justify-center items-center px-2.5 py-1";

const variantStyles = {
  default: "border border-border-primary bg-color-primary text-primary",
  primary: "border-transparent bg-primary text-surface-subtle",
};

const classes = [baseStyles, variantStyles[variant], className]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  <slot />
</div>
