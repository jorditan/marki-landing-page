---
import Subheading from "../../shared/Subheading.astro";
import FaqAccordion from "./FaqAccordion.astro";
import Container from "../../shared/Container.astro";
import Button from "../../shared/Button.astro";

const faqs = [
  {
    title: "¿Marki publica por mí en las redes sociales?",
    description: "No directamente. Marki genera el contenido, los diseños y las descripciones, y te envía recordatorios vía WhatsApp o Google Calendar para que vos solo tengas que copiar, pegar y publicar. Esto te da el control final sobre lo que sale en tu perfil."
  },
  {
    title: "¿Tengo que saber de marketing para usarlo?",
    description: "Para nada. Marki está diseñado precisamente para dueños de negocios que no tienen tiempo ni conocimientos técnicos. Solo respondés unas preguntas simples sobre tu negocio y Marki se encarga de toda la estrategia."
  },
  {
    title: "¿Qué tipo de contenido puede generar?",
    description: "Marki puede crear ideas y estructuras para publicaciones estáticas, Reels y Carruseles, adaptando siempre el tono de voz a la identidad de tu marca."
  },
  {
    title: "¿Puedo cancelar mi plan en cualquier momento?",
    description: "Sí, no hay contratos de permanencia. Podés dar de baja tu suscripción cuando quieras desde tu panel de configuración."
  }
];
---

<section class="w-full py-20 lg:py-32 bg-linear-to-t from-surface-primary-light to-surface-muted md:min-h-screen md:flex md:flex-col md:justify-center" id="preguntas-frecuentes">
  <Container class="flex flex-col gap-12 scroll-reveal">
    <div class="w-full flex justify-center gap-3 flex-col">
      <Subheading text={"Preguntas frecuentes"} />
      <h2
        class="font-bold text-primary-800 tracking-[-2px] lg:text-5xl text-3xl self-stretch text-center leading-[1.1]"
      >
        Lo que nos preguntan<br />
        <span class="text-primary-600 underline decoration-4 decoration-wavy">antes de arrancar</span>.
      </h2>
    </div>

    <p class="text-primary-800 text-lg lg:text-xl font-medium text-center max-w-2xl mx-auto">
      ¿Te quedás con una duda? Escribinos por WhatsApp y te respondemos en el día.
    </p>

    <div class="flex flex-col gap-4 max-w-4xl mx-auto w-full">
      {faqs.map((faq) => (
        <FaqAccordion title={faq.title} description={faq.description} />
      ))}
    </div>

    <!-- Support / Help Banner with Marki Icon -->
    <div
      class="mt-4 max-w-4xl mx-auto w-full bg-surface-white border border-border-default rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm hover:shadow-md transition-shadow duration-300"
    >
      <div class="flex items-center gap-4 text-center sm:text-left">
        <div class="p-3 bg-surface-primary-light border border-border-primary rounded-2xl shrink-0">
          <img
            src="/marki-icons/marki-icon.svg"
            alt="Marki ayuda"
            class="w-12 h-12"
          />
        </div>
        <div class="flex flex-col gap-1 w-3/4">
          <h3 class="text-xl font-bold text-primary-800 tracking-tight">
            ¿Tenés alguna pregunta específica?
          </h3>
          <p class="text-md font-medium text-primary-600">
            Agendá una demo personalizada y te mostramos cómo potenciar tu negocio.
          </p>
        </div>
      </div>
      <Button variant="primary" type="rounded" class="shrink-0" data-open-demo> Agendar demo </Button>

    </div>
  </Container>
</section>
