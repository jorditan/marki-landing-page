---
const { title, description, number } = Astro.props;
---

<div
  class="lg:p-8 md:p-6 p-4 flex flex-col gap-2 justify-start rounded-4xl border-2 border-border-default bg-surface-background items-start"
>
  <h3 class="font-bold text-primary-800 tracking-tighter lg:text-xl text-lg">
    {number}. {title}
  </h3>
  <p class="text-primary-800 font-medium text-left">{description}</p>
</div>
