---
import Subheading from "../../../shared/Subheading.astro";
import GenerationCard from "./GenerationCard.astro";
import variant1Raw from "../../../../../public/Variant1.svg?raw";
import variant2Raw from "../../../../../public/Variant2.svg?raw";
import lunesRaw from "../../../../../public/Lunes.svg?raw";
import martesRaw from "../../../../../public/Martes.svg?raw";
import miercolesRaw from "../../../../../public/Miercoles.svg?raw";
---

<article class="flex flex-col gap-6">
  <div class="w-full flex justify-center">
    <Subheading text="¿QUÉ ES GENERAR IDEAS Y PLANIFICAR?" />
  </div>
  <div class="flex lg:flex-row flex-col gap-8">
    <GenerationCard
      title="Generar ideas"
      description={`Le decís a Marki qué querés comunicar y te genera <strong class="font-bold text-primary-800">3 variantes de ideas creativas</strong> listas para tu publicación.
 
Editás, regenerás las opciones que quieras y guardás tus <strong class="font-bold text-primary-800">favoritas para usar después</strong>.`}
    >
      <div class="grid grid-cols-2 gap-3 w-full min-w-0">
        <div
          class="w-full h-auto object-contain scale-90 sm:scale-95 lg:scale-100 [&>svg]:w-full [&>svg]:h-auto"
          role="img"
          aria-label="Variante de idea rápida 1"
          set:html={variant1Raw}
        />
        <div
          class="w-full h-auto object-contain scale-90 sm:scale-95 lg:scale-100 [&>svg]:w-full [&>svg]:h-auto"
          role="img"
          aria-label="Variante de idea rápida 2"
          set:html={variant2Raw}
        />
      </div>
    </GenerationCard>
    <GenerationCard
      title="Planificación de contenido"
      description={`Marki te arma un <strong class="font-bold text-primary-800">calendario en base a tus objetivos, tu audiencia y los productos que querés destacar</strong>.
 
<strong class="font-bold text-primary-800">Te enseña de marketing</strong>: cada acción viene con un consejo de crecimiento para que entiendas el porqué.`}
    >
      <div class="grid grid-cols-3 gap-3 w-full min-w-0">
        <div
          class="w-full h-auto object-contain scale-90 sm:scale-95 lg:scale-100 [&>svg]:w-full [&>svg]:h-auto"
          role="img"
          aria-label="Planificación Lunes"
          set:html={lunesRaw}
        />
        <div
          class="w-full h-auto object-contain scale-90 sm:scale-95 lg:scale-100 [&>svg]:w-full [&>svg]:h-auto"
          role="img"
          aria-label="Planificación Martes"
          set:html={martesRaw}
        />
        <div
          class="w-full h-auto object-contain scale-90 sm:scale-95 lg:scale-100 [&>svg]:w-full [&>svg]:h-auto"
          role="img"
          aria-label="Planificación Miércoles"
          set:html={miercolesRaw}
        />
      </div>
    </GenerationCard>
  </div>
</article>
