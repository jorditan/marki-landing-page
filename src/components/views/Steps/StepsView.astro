---
import { ArrowDown } from "@lucide/astro";
import Subheading from "../../shared/Subheading.astro";
import StepCard from "./StepCard.astro";
import GenerationView from "./Generation/GenerationView.astro";


const steps = [
  {
    title: "Nos contás de tu negocio",
    description:
      "Respondés cuatro preguntas: qué vendés, a quién, dónde y tus objetivos",
    number: 1,
  },
  {
    title: "Marki analiza la información",
    description:
      "Lee todo lo que respondiste y lo guarda en su cerebro. Aprende de vos.",
    number: 2,
  },
  {
    title: "Creas tu primer contenido",
    description:
      "Vas a decidir si planificar contenido o generar publicaciones rápidas. ",
    number: 3,
  },
];
---

<section class="flex flex-col gap-8">
  <div class="flex justify-center w-full">
    <Subheading text="Cómo funciona" />
  </div>

  <h2
    class="font-bold text-primary-800 tracking-tighter lg:text-5xl text-xl self-stretch text-center justify-center"
  >
    Tres pasos. <br />
    <span class="text-primary-600">Sin curva de aprendizaje</span>
  </h2>

  <p class="text-primary-800 font-medium text-center">
    <span class="text-primary-600 font-bold"
      >No hace falta saber de marketing</span
    >. Si sabés mandar un mensaje, ya podés usar a Marki.
  </p>

  <article class="flex w-full justify-center items-center">
    <div class="flex flex-col w-2/4 gap-4 justify-center items-center">
      {
        steps.map((step, index) => (
          <StepCard
            title={step.title}
            description={step.description}
            number={step.number}
          />
          <ArrowDown class="text-primary-800" />
        ))
      }
    </div>
  </article>

  <GenerationView />

</section>
