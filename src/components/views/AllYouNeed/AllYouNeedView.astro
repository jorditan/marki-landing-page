---
import {
  Calendar,
  Lightbulb,
  FileText,
  Target,
  Bell,
  TrendingUp,
} from "@lucide/astro";
import Subheading from "../../shared/Subheading.astro";
import TileCard from "./TileCard.astro";
import IntegrationsCard from "./IntegrationsCard.astro";
import Container from "../../shared/Container.astro";

const tiles = [
  {
    title: "Calendario del mes",
    description:
      "Tu plan de contenido completo, ordenado por semana. Fácil de entender",
    icon: "calendar",
  },
  {
    title: "Sugerencias de Marki",
    description:
      "Recomendaciones cortas y accionables basadas en cómo te fué la semana pasada",
    icon: "lightbulb",
  },
  {
    title: "Descripciones listas",
    description:
      "Escribimos los textos de tus publicaciones en tu tono. Listo para copiar y pegars",
    icon: "fileText",
  },
  {
    title: "Objetivos claros",
    description:
      "Cada publicación tiene un para qué: ventas, alcance, comunidad. Sin contenido al voleo",
    icon: "target",
  },
  {
    title: "Recordatorios puntuales",
    description:
      "Te avisamos el día y la hora exacta. Imposible olvidarte una publicación",
    icon: "bell",
  },
  {
    title: "Estrategia semanal",
    description:
      "Marki te explica qué movió la aguja y qué probar la semana que viene",
    icon: "trendingUp",
  },
];

const iconMap: Record<string, any> = {
  calendar: Calendar,
  lightbulb: Lightbulb,
  fileText: FileText,
  target: Target,
  bell: Bell,
  trendingUp: TrendingUp,
};
---

<section class="w-full py-20 lg:py-32 bg-surface-muted md:min-h-screen md:flex md:flex-col md:justify-center relative overflow-hidden z-0">
  <div class="absolute -left-20 top-[10%] w-auto lg:auto h-auto pointer-events-none opacity-30 dark:opacity-15 blur-[0.5px] rotate-6 select-none z-[-1] transition-all duration-300 dark:invert dark:hue-rotate-180">
    <img src="/quickAction.svg" class="w-full h-auto object-contain" alt="" />
  </div>
  <div class="absolute right-24 bottom-[5%] w-auto lg:auto h-auto pointer-events-none opacity-30 dark:opacity-15 blur-[0.5px] -rotate-6 select-none z-[-1] transition-all duration-300 dark:invert dark:hue-rotate-180">
    <img src="/IAPLan.svg" class="w-full h-auto object-contain" alt="" />
  </div>

  <Container class="flex flex-col gap-12 scroll-reveal">
    <div class="flex justify-center w-full gap-4 flex-col items-center">
      <Subheading text="Lo que hace por vos" />
      <h2
        class="font-bold text-primary-800 tracking-[-2px] lg:text-5xl text-3xl self-stretch text-center leading-[1.1]"
      >
        Todo lo que necesitas para <br />
        <span class="text-primary-600 underline decoration-4 decoration-wavy">no estancarte</span>.
      </h2>
    </div>

    <article class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        tiles.map((tile, index) => {
          const Icon = iconMap[tile.icon];
          return (
            <div
              class="scroll-reveal"
              style={`transition-delay: ${index * 100}ms`}
            >
              <TileCard title={tile.title} description={tile.description}>
                {Icon && (
                  <Fragment slot="icon">
                    <Icon class="text-primary-800 h-6 w-6" />
                  </Fragment>
                )}
              </TileCard>
            </div>
          );
        })
      }
    </article>

    <div class="scroll-reveal delay-400">
      <IntegrationsCard />
    </div>
  </Container>
</section>
