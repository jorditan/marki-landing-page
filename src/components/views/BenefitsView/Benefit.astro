---
import { CheckCheckIcon, X } from "@lucide/astro";
import Subheading from "../../shared/Subheading.astro";
import Container from "../../shared/Container.astro";

const negatives = [
  "No sé que postear ni por qué.",
  "Mi perfil está estancado, hace meses.",
  "No entiendo cómo lograr mis objetivos en redes.",
  "Me frustro porque no veo resultados.",
];

const benefits = [
  "Marki te arma 30 ideas de contenido al mes con su motivo.",
  "Cada acción está pensada para mover un objetivo concreto.",
  "Te explicamos el “para qué” de cada publicación.",
  "Ves el progreso semana a semana, sin adivinar.",
];
---

<section class="w-full py-20 lg:py-32 bg-surface-muted min-h-screen relative overflow-hidden z-0">
  <!-- Decorative background illustrations -->
  <div class="absolute left-20 top-[15%] w-auto h-auto pointer-events-none opacity-20 dark:opacity-15 blur-[0.5px] -rotate-12 select-none z-[-1] transition-all duration-300 dark:invert dark:hue-rotate-180">
    <img src="/planning.svg" class="w-full h-auto object-contain" alt="" />
  </div>
  <div class="absolute right-20 bottom-[10%] w-auto lg:w-auto h-auto pointer-events-none opacity-20 dark:opacity-15 blur-[0.5px] rotate-12 select-none z-[-1] transition-all duration-300 dark:invert dark:hue-rotate-180">
    <img src="/valueProperty.svg" class="w-full h-auto object-contain" alt="" />
  </div>

  <Container class="flex flex-col gap-12 scroll-reveal">
    <div class="w-full flex justify-center gap-3 flex-col">
      <Subheading text={"El antes y después"} />
      <h2
        class="font-bold text-primary-800 tracking-[-2px] lg:text-5xl text-3xl self-stretch text-center leading-[1.1]"
      >
        De mirar tu perfil sin saber <br /> qué hacer, <span
          class="text-primary-600 underline decoration-4 decoration-wavy">a tener un plan claro</span
        >.
      </h2>
    </div>

    <p
      class="text-primary-800 text-lg lg:text-xl font-medium text-center max-w-2xl mx-auto"
    >
      Sabemos cómo es: abrís las redes sociales, mirás la pantalla y cerrás. <span
        class="text-primary-600 font-bold">Marki rompe ese ciclo</span
      >.
    </p>

    <div class="w-full justify-center flex">
      <div class="flex gap-8 flex-col lg:flex-row w-full lg:w-[90%] max-w-6xl">
        <div
          class="px-8 gap-6 w-full bg-surface-white py-10 flex flex-col rounded-[32px] border border-border-default shadow-sm hover:shadow-md transition-shadow duration-300 scroll-reveal delay-200"
        >
          <p class="text-2xl font-bold text-primary-800 tracking-tight">
            ¿Te sentís identificado?
          </p>

          <ul class="flex flex-col gap-4">
            {
              negatives.map((negative) => (
                <li class="text-primary-600 font-medium flex items-center gap-3">
                    <X class="h-4 w-4 text-red-800" />
                  <span>{negative}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="px-8 gap-6 w-full bg-surface-primary-light py-10 flex flex-col rounded-[32px] border border-border-primary shadow-xl hover:scale-[1.01] duration-800 scroll-reveal delay-400"
        >
          <p class="text-2xl font-bold text-primary-800 tracking-tight">
            Lo que pasa con nosotros
          </p>

          <ul class="flex flex-col gap-4">
            {
              benefits.map((benefit) => (
                <li class="text-primary-600 font-medium flex items-center gap-3">
                    <CheckCheckIcon class="h-4 w-4 text-green-700" />
                  <span>{benefit}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
