---
import { CheckCheckIcon, X } from "@lucide/astro";
import Subheading from "../../shared/Subheading.astro";

const negatives = [
  "No sé que postear ni por qué.",
  "Mi perfil está estancado, hace meses.",
  "No entiendo cómo lograr mis objetivos en redes.",
  "Me frustro porque no veo resultados.",
];

const benefits = [
  "Marki te arma 30 ideas de contenido al mes con su motivo.",
  "Cada acción está pensada para mover un objetivo concreto.",
  "Te explicamos el “para qué” de cada publicación.",
  "Ves el progreso semana a semana, sin adivinar.",
];
---

<section class="flex flex-col gap-8">
  <div class="w-full flex justify-center gap-2 flex-col">
    <Subheading text={"El antes y después"} />
    <h2
      class="font-bold text-primary-800 lg:text-5xl text-xl self-stretch text-center justify-center"
    >
      De mirar tu perfil sin saber <br /> qué hacer, <span
        class="text-primary-600">a tener un plan claro</span
      >.
    </h2>
  </div>

  <p class="text-primary-800 font-medium text-center">
    Sabemos cómo es: abrís las redes sociales, mirás la pantalla y cerrás. <span
      class="text-primary-600 font-bold">Marki rompe ese cliclo</span
    >.
  </p>

  <div class="w-full justify-center flex">
    <div class="flex gap-6 flex-col lg:flex-row w-3/4">
      <div
        class="px-8 gap-4 w-full bg-surface-background py-8 flex flex-col rounded-[32px] border border-border-default shadow-md"
      >
        <p class="text-2xl font-bold text-primary-800">
          ¿Te sentis identificado?
        </p>

        <div>
          <ul class="flex flex-col gap-2">
            {
              negatives.map((negative) => (
                <li class="text-primary-800 font-medium">
                  <X class="h-4 w-4 text-red-800 inline-block align-text-bottom" />
                  {negative}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div
        class="px-8 gap-4 w-full bg-surface-primary-subtle py-8 flex flex-col rounded-[32px] border border-border-primary shadow-xl"
      >
        <p class="text-2xl font-bold text-primary-800">
          Lo que pasa con nosotros
        </p>

        <div>
          <ul class="flex flex-col gap-2">
            {
              benefits.map((benefit) => (
                <li class="text-primary-800 font-medium">
                  <CheckCheckIcon class="h-4 w-4 text-green-800 inline-block align-text-bottom" />
                  {benefit}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
