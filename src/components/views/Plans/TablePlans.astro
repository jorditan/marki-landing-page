---
import Subheading from "../../shared/Subheading.astro";
import Badge from "../../shared/Badge.astro";
import Button from "../../shared/Button.astro";
import Container from "../../shared/Container.astro";

const plans = [
  {
    id: "inicial",
    name: "Inicial",
    price: "11 000",
    currency: "ARS",
    period: "/ mes",
    recommended: false,
    cta: "Elegir inicial",
    variant: "secondary" as const,
  },
  {
    id: "intermedio",
    name: "Intermedio",
    price: "22 000",
    currency: "ARS",
    period: "/ mes",
    recommended: true,
    cta: "Agendar demo",
    variant: "primary" as const,
  },
  {
    id: "avanzado",
    name: "Avanzado",
    price: "44 000",
    currency: "ARS",
    period: "/ mes",
    recommended: false,
    cta: "Elegir avanzado",
    variant: "secondary" as const,
  },
];

const features = [
  {
    title: "Ideas rápidas",
    subtitle: "Ideas para posts, reels y carruseles",
    values: {
      inicial: "7 x mes",
      intermedio: "15 x mes",
      avanzado: "20 x mes",
    },
  },
  {
    title: "Estrategia semanal",
    subtitle: "Plan de contenido para 7 días",
    values: { inicial: true, intermedio: true, avanzado: true },
  },
  {
    title: "Estrategia quincenal",
    subtitle: "Publicaciones, reels, carruseles",
    values: { inicial: false, intermedio: true, avanzado: true },
  },
  {
    title: "Estrategia mensual",
    subtitle: "Plan de contenido para 7 días",
    values: { inicial: false, intermedio: false, avanzado: true },
  },
  {
    title: "Recordatorios por Whats’s App",
    subtitle: "Avisos para cada publicación",
    values: { inicial: true, intermedio: true, avanzado: true },
  },
  {
    title: "Calendario de Google",
    subtitle: "Sincronización con tu agenda",
    values: { inicial: false, intermedio: true, avanzado: true },
  },
];
---

<section class="w-full py-20 lg:py-32 md:min-h-screen md:flex md:flex-col md:justify-center relative overflow-hidden" id="precios">
  <Container class="flex flex-col gap-12">
    <!-- Header -->
    <div class="w-full flex justify-center gap-3 flex-col scroll-reveal">
      <Subheading text={"Precios"} />
      <h2
        class="font-bold text-primary-800 tracking-[-2px] lg:text-5xl text-4xl self-stretch text-center leading-[1.1]"
      >
        Compará y elegí <br /> el que te queda mejor
      </h2>
    </div>

    <!-- Mobile View: Cards -->
    <div
      class="lg:hidden flex flex-col gap-6 scroll-reveal delay-200"
    >
      {
        plans.map((plan) => (
          <div
            class={`relative flex flex-col gap-6 p-8 rounded-2xl border transition-all duration-300 ${
              plan.recommended
                ? "bg-surface-primary-light border-border-primary shadow-xl scale-[1.02]"
                : "bg-surface-white border-border-default shadow-sm"
            }`}
          >
            {plan.recommended && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <Badge
                  variant="primary"
                  class="text-md font-bold px-3 py-1 tracking-wider shadow-sm"
                >
                  Recomendado
                </Badge>
              </div>
            )}

            <div class="flex flex-col items-center gap-2">
              <span class="text-xl font-bold text-primary-700 tracking-tight">
                {plan.name}
              </span>
              <div class="flex items-baseline gap-1">
                <span class="text-3xl font-bold text-primary tracking-tighter">
                  $ {plan.price}
                </span>
                <span class="text-base font-bold text-primary">
                  {plan.currency}
                </span>
                <span class="text-base font-normal text-ui-subtitle">
                  {plan.period}
                </span>
              </div>
            </div>

            <div class="flex flex-col gap-4 py-4 border-y border-border-default/50">
              {features.map((feature) => {
                const val =
                  feature.values[plan.id as keyof typeof feature.values];
                return (
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex flex-col gap-0.5">
                      <span class="text-sm font-medium text-neutral-900">
                        {feature.title}
                      </span>
                      <span class="text-md text-ui-subtitle leading-tight">
                        {feature.subtitle}
                      </span>
                    </div>
                    <div class="flex shrink-0">
                      {typeof val === "boolean" ? (
                        val ? (
                          <svg
                            width="20"
                            height="20"
                            viewBox="0 0 20 20"
                            fill="none"
                            class="text-primary"
                          >
                            <path
                              d="M4.16669 10.8333L7.50002 14.1667L15.8334 5.83331"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : (
                          <span class="text-ui-placeholder font-bold text-lg">
                            -
                          </span>
                        )
                      ) : (
                        <span class="text-sm font-bold text-neutral-900">
                          {val}
                        </span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>

            <Button
              variant={plan.variant}
              type="rounded"
              data-open-demo
            >
              {plan.cta}
            </Button>
          </div>
        ))
      }
    </div>

    <div
      class="hidden lg:block bg-surface-white border border-border-muted rounded-2xl overflow-hidden shadow-2xl scroll-reveal delay-400"
    >
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b border-border-muted">
              <th class="bg-surface-muted/50 p-8 text-left w-70">
                <span class="text-base font-semibold text-ui-dark "
                  >Qué incluye</span
                >
              </th>
              {
                plans.map((plan) => (
                  <th
                    class={`p-8 text-center min-w-60 transition-colors duration-300 ${
                      plan.recommended
                        ? "bg-surface-primary-light border-x border-border-primary-subtle"
                        : "bg-surface-muted/30"
                    }`}
                  >
                    <div class="flex flex-col items-center gap-2">
                      <div class="flex items-center gap-2">
                        <span class="text-xl font-bold text-primary-700 tracking-tight">
                          {plan.name}
                        </span>
                        {plan.recommended && (
                          <Badge
                          variant="primary"
                          >
                            Recomendado
                          </Badge>
                        )}
                      </div>
                      <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold text-primary tracking-tighter">
                          $ {plan.price}
                        </span>
                        <span class="text-lg font-bold text-primary">
                          {plan.currency}
                        </span>
                        <span class="text-lg font-medium text-ui-subtitle">
                          {plan.period}
                        </span>
                      </div>
                    </div>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              features.map((feature, idx) => (
                <tr
                  class={`group transition-colors duration-200 ${idx % 2 !== 0 ? "bg-surface-muted/10" : "bg-surface-white"}`}
                >
                  <td class="p-6 px-8 border-b border-border-default/60">
                    <div class="flex flex-col gap-0.5 transition-transform">
                      <span class="text-base font-medium text-neutral-900 ">
                        {feature.title}
                      </span>
                      <span class="text-sm text-ui-subtitle leading-normal">
                        {feature.subtitle}
                      </span>
                    </div>
                  </td>
                  {plans.map((plan) => {
                    const val =
                      feature.values[plan.id as keyof typeof feature.values];
                    return (
                      <td
                        class={`p-6 text-center border-b border-border-default/60 transition-colors duration-300 ${
                          plan.recommended
                            ? "bg-surface-primary-light border-x border-border-primary-subtle"
                            : "group-hover:bg-surface-muted/5"
                        }`}
                      >
                        <div class="flex items-center justify-center gap-2">
                          {typeof val === "boolean" ? (
                            val ? (
                              <div class="bg-primary/10 p-1 rounded-full">
                                <svg
                                  width="18"
                                  height="18"
                                  viewBox="0 0 20 20"
                                  fill="none"
                                  class="text-primary"
                                >
                                  <path
                                    d="M4.16669 10.8333L7.50002 14.1667L15.8334 5.83331"
                                    stroke="currentColor"
                                    stroke-width="3"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                </svg>
                              </div>
                            ) : (
                              <span class="text-ui-placeholder font-bold text-xl">
                                -
                              </span>
                            )
                          ) : (
                            <span class="text-md font-bold text-ui-dark">
                              {val}
                            </span>
                          )}
                        </div>
                      </td>
                    );
                  })}
                </tr>
              ))
            }
            <tr>
              <td class="p-8"></td>
              {
                plans.map((plan) => (
                  <td
                    class={`p-8 pt-10 ${
                      plan.recommended
                        ? "bg-surface-primary-light border-x border-border-primary-subtle"
                        : ""
                    }`}
                  >
                    <div class="flex justify-center">
                      <Button
                        variant={plan.variant}
                        type="rounded"
                        data-open-demo
                        class="w-full"
                      >
                        {plan.cta}
                      </Button>
                    </div>
                  </td>
                ))
              }
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</section>
