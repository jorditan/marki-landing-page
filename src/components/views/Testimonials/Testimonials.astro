---
import Subheading from "../../shared/Subheading.astro";
import Container from "../../shared/Container.astro";

const testimonials = [
  {
    name: "Sofía Rodríguez",
    handle: "@sofia.mkt",
    role: "Social Media Manager",
    avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=120&h=120&q=80",
    content: "Marki cambió por completo cómo organizo las publicaciones de mis clientes. Antes pasaba horas pensando qué subir, ahora tengo ideas semanales listas en minutos con la IA. ¡Una locura de herramienta!",
    source: "twitter"
  },
  {
    name: "Mateo Silva",
    handle: "@mateosilvadev",
    role: "Founder de TechStart",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&h=120&q=80",
    content: "Como founder técnico, redactar posts atractivos era un dolor de cabeza. Con Marki solo respondo un par de preguntas y me arma copies espectaculares. El plan estratégico que propone tiene muchísimo sentido.",
    source: "linkedin"
  },
  {
    name: "Camila Fernández",
    handle: "@camila_designer",
    role: "Product Designer Freelance",
    avatar: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=120&h=120&q=80",
    content: "Estéticamente la plataforma es hermosa, pero su valor real está en que te explica el 'para qué' de cada publicación. No es solo un generador automático de humo, hay estrategia detrás.",
    source: "instagram"
  },
  {
    name: "Lucas Benítez",
    handle: "@lucas.b",
    role: "E-commerce Owner",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&h=120&q=80",
    content: "Desde que uso Marki para planificar las publicaciones de mi tienda en línea, he notado un aumento significativo en la interacción de mis seguidores. Ser constante se volvió ridículamente fácil.",
    source: "twitter"
  },
  {
    name: "Valentina Gómez",
    handle: "@valen.consultora",
    role: "Asesora de Marcas",
    avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=120&h=120&q=80",
    content: "Le recomendé Marki a tres de mis clientes que no podían pagar un community manager a tiempo completo. Están felices y armando calendarios de contenido súper sólidos ellos solos.",
    source: "linkedin"
  },
  {
    name: "Diego Rossi",
    handle: "@diegorossi.ok",
    role: "Creador de Contenido",
    avatar: "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?auto=format&fit=crop&w=120&h=120&q=80",
    content: "Ahorro al menos 10 horas de brainstorming a la semana. Dejo que Marki estructure las bases del mes y yo solo me enfoco en grabar y darle mi toque final. Es el mejor copiloto que he tenido.",
    source: "instagram"
  }
];
---

<section class="w-full py-20 lg:py-32 bg-surface-muted/50 min-h-screen relative overflow-hidden z-0" id="comunidad">
  <!-- Blurry background blobs (Capacities style) -->
  <div class="absolute top-[20%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 dark:bg-primary/10 rounded-full blur-[140px] pointer-events-none z-[-1]"></div>
  <div class="absolute bottom-[10%] right-[-10%] w-[400px] h-[400px] bg-primary-200/10 dark:bg-primary-900/10 rounded-full blur-[100px] pointer-events-none z-[-1]"></div>
  <div class="absolute top-[60%] left-[-10%] w-[350px] h-[350px] bg-primary-300/10 dark:bg-primary-800/10 rounded-full blur-[90px] pointer-events-none z-[-1]"></div>

  <Container class="flex flex-col gap-16 scroll-reveal">
    <!-- Header -->
    <div class="w-full flex justify-center gap-3 flex-col">
      <Subheading text={"Comunidad"} />
      <h2
        class="font-bold text-primary-800 tracking-[-2px] lg:text-5xl text-3xl self-stretch text-center leading-[1.1]"
      >
        Amado por personas <br />
        <span class="text-primary-600 underline decoration-4 decoration-wavy">que hacen crecer marcas</span>.
      </h2>
    </div>

    <!-- Slogan paragraph -->
    <p class="text-primary-800 text-lg lg:text-xl font-medium text-center max-w-2xl mx-auto -mt-6">
      Descubrí cómo emprendedores, agencias y creadores de contenido utilizan Marki para automatizar su estrategia y simplificar su día a día.
    </p>

    <!-- Testimonials Masonry Grid -->
    <div class="w-full justify-center flex">
      <div class="w-full max-w-6xl columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
        {testimonials.map((item) => (
          <div class="break-inside-avoid bg-surface-white border border-border-default rounded-[28px] p-6 shadow-sm hover:shadow-md hover:border-border-muted transition-all duration-300 flex flex-col gap-4">
            <!-- User Profile & Social Icon -->
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3.5">
                <img 
                  src={item.avatar} 
                  alt={item.name} 
                  class="w-11 h-11 rounded-full object-cover border border-border-default shadow-xs"
                  loading="lazy"
                />
                <div class="flex flex-col">
                  <span class="font-bold text-ui-dark text-base leading-tight">{item.name}</span>
                  <span class="text-xs text-ui-muted font-semibold mt-0.5">{item.role}</span>
                </div>
              </div>
              
              <!-- Brand/Network Icon -->
              <div class="flex items-center justify-center w-8 h-8 rounded-full bg-surface-muted text-ui-muted">
                {item.source === "twitter" && (
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                )}
                {item.source === "linkedin" && (
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                )}
                {item.source === "instagram" && (
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                  </svg>
                )}
              </div>
            </div>
            
            <!-- Content Text -->
            <p class="text-ui-dark text-base leading-relaxed font-medium">
              "{item.content}"
            </p>
            
            <!-- Handle -->
            <div class="flex items-center pt-2.5 border-t border-border-light text-xs font-semibold text-ui-muted">
              <span>{item.handle}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
