---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/marki-icons/marki-pc.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Marki, tu amigo CM</title>
    <Analytics />
  </head>
  <body class="min-h-screen">
    <slot />
    <script>
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          }
        });
      }, observerOptions);

      document.addEventListener("DOMContentLoaded", () => {
        const revealElements = document.querySelectorAll(".scroll-reveal");
        revealElements.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>

<style>
  html {
    scroll-padding-top: 5.5rem; /* Evita que el navbar fijo tape el inicio de las secciones */
  }
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import Hotjar from "@hotjar/browser";

  const siteId = 6717558;
  const hotjarVersion = 6;

  Hotjar.init(siteId, hotjarVersion);
</script>
